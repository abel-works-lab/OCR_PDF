{
  "manifest_version": 3,
  "name": "OCR Page Capture",
  "version": "1.0",
  "minimum_chrome_version": "121",
  "description": "WebページをキャプチャしHTMLを抽出してGeminiに送るChrome拡張機能",
  "permissions": [
    "tabs",
    "activeTab",
    "sidePanel",
    "scripting",
    "clipboardWrite",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "capture-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "現在のページをキャプチャしてバッファに追加"
    }
  },
  "action": {
    "default_title": "OCR Capture - クリックでサイドパネルを開く"
  }
}
